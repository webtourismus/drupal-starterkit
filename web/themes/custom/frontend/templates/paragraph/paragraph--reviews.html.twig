{% extends "@frontend/paragraph/paragraph--textslider.html.twig" %}

{% block content %}
  {{ parent() }}

  {# Built in frontend_preprocess_paragraph__reviews(), already JSON-encoded. #}
  {% for review_schema in reviews_schema %}
    <script type="application/ld+json">{{ review_schema|raw }}</script>
  {% endfor %}
{% endblock %}

{% block items %}
    {% for review in content.field_reviews|children %}
        {% block item %}
            <div {{ item_attributes }}>
                {{ review }}
            </div>
        {% endblock item %}
    {% endfor %}
{% endblock %}
